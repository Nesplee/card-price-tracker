# Copier ce fichier vers .env et remplir les valeurs réelles. .env ne doit JAMAIS être commité.

# Base de données Postgres (locale, via docker-compose)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=card_tracker
POSTGRES_APP_USER=pipeline_app
POSTGRES_APP_PASSWORD=changeme
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=changeme_admin

# API pokemontcg.io (clé gratuite : https://dev.pokemontcg.io)
POKEMONTCG_API_KEY=changeme

# Metabase (UI d'exploration de la base de données, Mois 3) : rôle Postgres
# dédié en lecture seule sur le schéma prod, jamais pipeline_app.
DASHBOARD_READER_PASSWORD=changeme_dashboard_reader
# DASHBOARD_READER_PASSWORD est aussi utilisée par l'API du dashboard sur
# mesure (dashboard-api, voir docker-compose.prod.yml) -- même rôle Postgres
# en lecture seule que Metabase, pas de nouvelle variable nécessaire.

# Certificat Tailscale (accès permanent Metabase/dashboard, voir
# docs/superpowers/specs/2026-08-14-tailscale-remote-access-design.md) :
# mot de passe du keystore PKCS12 généré à partir du certificat Tailscale
# pour Metabase (Jetty n'accepte pas de PEM brut). Générer une vraie valeur
# aléatoire pour .env, ex: python3 -c "import secrets; print(secrets.token_hex(30))"
METABASE_KEYSTORE_PASSWORD=changeme_metabase_keystore
# TAILSCALE_IP : décommenter et renseigner en prod (récupérer la valeur via
# `tailscale ip -4` sur le VPS). Laissé commenté ici : la valeur par défaut
# 127.0.0.1 dans docker-compose.prod.yml s'applique tant que cette variable
# n'est pas définie.
#TAILSCALE_IP=100.x.x.x

# TAILSCALE_HOSTNAME : nom MagicDNS complet du VPS (récupérer via
# `tailscale status` sur le VPS, ou dans la console admin Tailscale),
# utilisé pour la vérification du certificat TLS (SNI) par le healthcheck
# Metabase, par nginx (frontend, vérification du certificat de dashboard-api
# en amont) et par scripts/renew_tailscale_cert.sh (renouvellement du
# certificat Let's Encrypt via `tailscale cert`). Jamais en dur dans un
# fichier versionné : c'est une information d'infrastructure propre à CE
# VPS, pas un secret à proprement parler, mais elle ne doit pas identifier
# publiquement un serveur de production réel dans un repo portfolio.
TAILSCALE_HOSTNAME=changeme_your-tailnet-hostname.ts.net

# Airflow (local, LocalExecutor, métadonnées dans un Postgres dédié)
AIRFLOW_DB_PASSWORD=changeme_airflow
AIRFLOW_ADMIN_PASSWORD=changeme_admin_airflow
# Clé partagée par webserver ET scheduler (voir docker-compose.yml) : signe
# les requêtes HTTP internes de récupération de logs entre les deux
# conteneurs. DOIT être identique des deux côtés, sinon cette récupération
# échoue silencieusement. Générer une vraie valeur aléatoire pour .env, ex:
# python3 -c "import secrets; print(secrets.token_hex(30))"
AIRFLOW_SECRET_KEY=changeme_generate_a_random_string
# UID de TON utilisateur hôte (pas une valeur à choisir arbitrairement) :
# récupère la vraie valeur avec `id -u` et colle-la ici, dans .env. Utilisée
# par docker-compose.yml (directive "user:" sur airflow-webserver et
# airflow-scheduler) pour que les CONTENEURS Airflow écrivent dans ./logs
# (monté depuis l'hôte) avec TON uid, pas l'uid 50000 par défaut de l'image
# -- sinon le conteneur ne peut pas écrire dans un dossier appartenant à ton
# utilisateur hôte. Voir le commentaire détaillé sur "user:" dans
# docker-compose.yml pour le mécanisme complet.
AIRFLOW_UID=changeme_run_id_-u_and_paste_the_number
